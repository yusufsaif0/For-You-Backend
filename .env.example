# MongoDB connection used by the FastAPI service. Do not commit your real .env file.
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=daily_life

# Comma-separated browser origins. Use * only for local development.
CORS_ORIGINS=*

# Set APP_ENV=production when deployed. Production requires Firebase credentials
# and a strict HTTPS CORS origin allow-list.
APP_ENV=development
FIREBASE_PROJECT_ID=
# Set this only in the backend's secret manager, never in the app or repository.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional food-photo analysis. Create a key in Google AI Studio and keep it server-side.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
