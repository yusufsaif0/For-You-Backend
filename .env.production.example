# Set these in Railway Variables. Never commit a populated environment file.
APP_ENV=production
MONGODB_URL=mongodb+srv://USERNAME:PASSWORD@YOUR_ATLAS_CLUSTER/daily_life
DATABASE_NAME=daily_life
FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
FIREBASE_SERVICE_ACCOUNT_JSON=YOUR_FIREBASE_ADMIN_SERVICE_ACCOUNT_JSON
# Empty for an APK-only deployment. For a web client, list its exact HTTPS origin.
CORS_ORIGINS=
# Optional: required only for food-photo and document analysis.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
